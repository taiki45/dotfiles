set main-view = id date author commit-title:graph=yes,refs=yes

# Show line numbers on pager views, set interval=1 (default: line-number:no,interval=5)
set blame-view  = date:default author:email-user id:yes,color line-number:yes,interval=1 text
set blob-view   = line-number:yes,interval=1 text

# A line-number column makes tig skip that many characters at each wrap point, so
# the views used to read diffs carry no line-number column.
set wrap-lines  = yes
set pager-view  = text
set stage-view  = text
set log-view    = text
set diff-view   = text:yes,commit-title-overflow=no

# To switch behavior, press `W` in diff view.
set ignore-space = all

# diff-highlight rewrites the +/- lines with its own escape sequences, and tig
# leaves a line carrying escapes unwrapped, so those lines run off the edge.
# `w` drops the highlighting and the view wraps at once, `i` puts it back from
# the next time the diff view is opened. `:toggle diff-highlight` is unsupported.
set diff-highlight = true
bind generic w :set diff-highlight = no
bind generic i :set diff-highlight = yes

set ignore-case = true

# Show merge diffs
set diff-options = -m --first-parent
